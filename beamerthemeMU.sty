%% beamerthemeMU.sty
%% Tema Beamer para presentaciones de Mondragon Unibertsitatea (Enpresagintza).
%% Sigue el sistema de diseño MU: plantilla PPT 16:9, paleta de verdes, Duplicate.
%%
%% Uso:   \documentclass[aspectratio=169]{beamer}
%%        \usetheme[brand=enpresagintza,lang=eu]{MU}
%% Motor: LuaLaTeX o XeLaTeX (Duplicate Sans/Slab). Con pdfLaTeX se usa
%%        Helvetica como sustituto de Arial.
%%
%% Opciones (clave=valor):
%%   brand        mu | enpresagintza | profesionales | mik   (logotipo; def. mu)
%%   lang         eu | es | en   (logotipo de facultad; en solo con brand=mik; def. eu)
%%   palette      mu | eps | huhezi | enpresagintza | prof  (gama de color; def. mu)
%%   font         sans | slab        (titulares: Sans institucional, Slab actividad; def. sans)
%%   weight       medium | bold      (medium = académico, bold = no académico; def. medium)
%%   sectionpages true | false       (diapositiva de sección automática; def. true)
%%   subsectionpages true | false    (diapositiva de subsección automática; def. false)
%%
%% Comandos propios:
%%   \sectionsubtitle{..}  subtítulo de la próxima \section
%%   \subsectionsubtitle{..} subtítulo de la próxima \subsection
%%   \mudestacado[título]{cita}{apoyo}   diapositiva destacada (uso limitado)
%%   \muclosing{contacto}  contraportada con el agradecimiento en el idioma de lang
%%   \muthankstext{..}     cambia el texto de agradecimiento
%%   \mufootercenter{..}   texto central del pie (def. Mondragon Unibertsitatea; MIK S. Coop. con brand=mik)
%%   \muassets             carpeta de recursos (def. assets/)
\ProvidesPackage{beamerthemeMU}[2026/10/28 Tema Beamer Mondragon Unibertsitatea]

\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{iftex}
\RequirePackage{pgfopts}

\providecommand\muassets{assets/}

%% ---------- Opciones ----------
\def\mu@brand{mu}
\def\mu@lang{eu}
\def\mu@palette{mu}
\def\mu@font{sans}
\def\mu@weight{medium}
\def\mu@sectionpages{true}
\def\mu@subsectionpages{false}
\pgfkeys{/mu/.cd,
  brand/.store in=\mu@brand,
  lang/.store in=\mu@lang,
  palette/.store in=\mu@palette,
  font/.store in=\mu@font,
  weight/.store in=\mu@weight,
  sectionpages/.store in=\mu@sectionpages,
  subsectionpages/.store in=\mu@subsectionpages}
\ProcessPgfOptions{/mu}

%% ---------- Color ----------
% Neutros y de apoyo comunes
\definecolor{musecundario}{HTML}{889396}   % texto-secundario
\definecolor{mucta}{HTML}{FFC72C}          % cta-123
% Gamas: acento (brillante), oscuro, profundo (fondo de portada), tinte (formas claras)
\def\mu@setpalette#1#2#3#4{%
  \definecolor{muaccent}{HTML}{#1}%
  \definecolor{mudark}{HTML}{#2}%
  \definecolor{mudeep}{HTML}{#3}%
  \definecolor{mutint}{HTML}{#4}}
\ifdefstring{\mu@palette}{mu}{\mu@setpalette{00A3AD}{004851}{053139}{BFE8EB}}{%
\ifdefstring{\mu@palette}{eps}{\mu@setpalette{ED8B00}{B33D26}{7B2A1A}{F6C580}}{%
\ifdefstring{\mu@palette}{huhezi}{\mu@setpalette{DA1884}{6C1D45}{4A1230}{ED8CC2}}{%
\ifdefstring{\mu@palette}{enpresagintza}{\mu@setpalette{509E2F}{275D38}{1B4127}{A8CF97}}{%
\ifdefstring{\mu@palette}{prof}{\mu@setpalette{D50032}{2C2A29}{2C2A29}{D9D9D9}}{%
  \PackageError{beamerthemeMU}{Paleta desconocida: \mu@palette}{Usa mu, eps, huhezi, enpresagintza o prof.}}}}}}
% La tinta de las formas de la portada es siempre un tono claro de la gama
\def\mu@ganchofile{gancho-\mu@palette}

%% ---------- Tipografía ----------
\setbeamertemplate{navigation symbols}{}
\usefonttheme{professionalfonts}
\ifPDFTeX
  \RequirePackage[scaled=.92]{helvet}
  \renewcommand{\familydefault}{\sfdefault}
  \def\mu@titlefont{\bfseries}
  \def\mu@heavyfont{\bfseries}
\else
  \RequirePackage{fontspec}
  \IfFileExists{\muassets fonts/DuplicateSans.ttf}{%
    \setsansfont[Path=\muassets fonts/,
      UprightFont=DuplicateSans.ttf, BoldFont=DuplicateSans-Bold.ttf,
      ItalicFont=DuplicateSans-Italic.ttf, BoldItalicFont=DuplicateSans-BoldItalic.ttf]{DuplicateSans.ttf}%
    \ifdefstring{\mu@font}{slab}{\def\mu@fam{Slab}}{\def\mu@fam{Sans}}%
    \ifdefstring{\mu@weight}{bold}{\def\mu@wt{Bold}}{\def\mu@wt{Medium}}%
    \newfontfamily\mu@titlefont[Path=\muassets fonts/]{Duplicate\mu@fam-\mu@wt.ttf}%
    \newfontfamily\mu@heavyfont[Path=\muassets fonts/]{Duplicate\mu@fam-Bold.ttf}%
  }{%
    \PackageWarning{beamerthemeMU}{No se encuentra Duplicate en \muassets fonts/; uso TeX Gyre Heros (similar a Arial)}%
    \setsansfont{TeX Gyre Heros}%
    \let\mu@titlefont\bfseries
    \let\mu@heavyfont\bfseries
  }
  \renewcommand{\familydefault}{\sfdefault}
\fi

%% ---------- Colores de Beamer ----------
\setbeamercolor{normal text}{fg=mudark,bg=white}
\setbeamercolor{structure}{fg=muaccent}
\setbeamercolor{frametitle}{fg=muaccent}
\setbeamercolor{alerted text}{fg=mudark}
\setbeamercolor{footline}{fg=muaccent}
\setbeamercolor{itemize item}{fg=muaccent}
\setbeamercolor{itemize subitem}{fg=mudark}
\setbeamercolor{enumerate item}{fg=muaccent}
\setbeamercolor{title}{fg=white}
\setbeamercolor{block title}{fg=mudark,bg=mutint}
\setbeamercolor{block body}{fg=mudark,bg=mutint!30!white}
\setbeamercolor{block title alerted}{fg=mudark,bg=mucta}
\setbeamercolor{block body alerted}{fg=mudark,bg=mucta!20!white}
\setbeamercolor{block title example}{fg=white,bg=mudark}
\setbeamercolor{block body example}{fg=mudark,bg=mutint!30!white}
\setbeamercolor{caption name}{fg=muaccent}
\setbeamercolor{bibliography entry author}{fg=mudark}
\setbeamercolor{bibliography entry title}{fg=mudark}
\setbeamercolor{bibliography entry note}{fg=musecundario}

\setbeamerfont{frametitle}{series=\mdseries,size=\fontsize{20}{22}\selectfont}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{alerted text}{series=\bfseries}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{footnote}{size=\tiny}

\setbeamertemplate{itemize item}{\raisebox{.1ex}{\scriptsize$\bullet$}}
\setbeamertemplate{itemize subitem}{\raisebox{.32ex}{\rule{.55em}{.6pt}}}
\setbeamertemplate{itemize subsubitem}{\raisebox{.1ex}{\tiny$\bullet$}}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertenumlabel.\insertsubenumlabel}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{section in toc}{\color{muaccent}\inserttocsectionnumber.~\color{mudark}\inserttocsection}
\setbeamertemplate{subsection in toc}{\hspace{1.2em}\color{mudark}\inserttocsubsection}

%% ---------- Geometría ----------
\setkeys{beamerframe}{t}% contenido arriba por defecto (como la plantilla PPT)
\setbeamersize{text margin left=6.9mm,text margin right=6.9mm}
\tikzset{mupage/.style={remember picture,overlay,
  shift={(current page.north west)},x=.01\paperwidth,y=-.01\paperheight}}

%% ---------- Logotipos ----------
