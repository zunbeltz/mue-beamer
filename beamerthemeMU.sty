\def\mu@miklang{gaztelera}
\ifdefstring{\mu@lang}{eu}{\def\mu@miklang{euskara}}{}
\ifdefstring{\mu@lang}{en}{\def\mu@miklang{ingelesa}}{}
\ifdefstring{\mu@brand}{mik}{\mu@miktrue}{}
