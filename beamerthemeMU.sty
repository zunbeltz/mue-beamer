  \end{tikzpicture}\par}

\def\mu@footercenter{Mondragon Unibertsitatea}
\ifmu@mik\def\mu@footercenter{MIK S. Coop.}\fi
\newcommand\mufootercenter[1]{\def\mu@footercenter{#1}}
\setbeamertemplate{footline}{%
  \leavevmode\vbox to 9.5mm{\vss
    \hbox to \paperwidth{\hskip 6.9mm
      \hbox to \dimexpr\paperwidth-13.8mm\relax{%
        \usebeamercolor[fg]{footline}\fontsize{8}{9}\selectfont
        \hbox to 0pt{\insertshortdate\hss}\hfil\mu@footercenter\hfil
        \hbox to 0pt{\hss\insertframenumber}}%
      \hskip 6.9mm}%
    \vss}}

%% ---------- Portada ----------
\setbeamertemplate{title page}{%
  \gdef\mu@style{title}%
  \begin{tikzpicture}[mupage]
