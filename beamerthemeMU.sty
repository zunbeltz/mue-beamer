\setbeamertemplate{background canvas}{}

%% ---------- Título de transparencia, cabecera y pie ----------
\setbeamertemplate{headline}{\leavevmode\vbox to \mu@headh{\vss}}
\setbeamertemplate{frametitle}{%
  \nointerlineskip
