%% ---------- Secciones y subsecciones (como la plantilla PPT) ----------
% Forma diagonal grande arriba a la izquierda, forma oscura con el número detrás,
% título a la derecha del número y subtítulo debajo. Posiciones de la plantilla.
\def\mu@secsub{}
\newcommand\sectionsubtitle[1]{\gdef\mu@secsub{#1}}
\def\mu@subsecsub{}
\newcommand\subsectionsubtitle[1]{\gdef\mu@subsecsub{#1}}
% #1 forma (seccion|subseccion)  #2 número  #3 título  #4 color del título
% #5 color del subtítulo  #6 subtítulo
\newcommand\mu@sectionslide[6]{%
  \begin{frame}[plain]
    \gdef\mu@style{section}%
    \begin{tikzpicture}[mupage]
      \clip (0,0) rectangle (100,100);
      \node[anchor=north west,inner sep=0] at (0,0)
        {\includegraphics[width=.573\paperwidth]{\muassets formas/#1-\mu@palette.png}};
      \node[anchor=north west,inner sep=0] at (0,13.6)
        {\includegraphics[width=.152\paperwidth]{\muassets formas/numero-\mu@palette.png}};
      \node[inner sep=0,text=white] at (7,46)
        {\mu@heavyfont\fontsize{17}{20}\selectfont #2};
      \node[anchor=south west,inner sep=0,text=#4,text width=.27\paperwidth,align=left]
        at (19.6,58.8)
        {\hyphenpenalty=10000 \mu@heavyfont\fontsize{16}{19}\selectfont #3\par};
      \node[anchor=north west,inner sep=0,text=#5,text width=.27\paperwidth,align=left]
        at (19.6,62)
        {\normalfont\sffamily\fontsize{10}{13}\selectfont #6\par};
      \ifmu@mik\mu@mikcolor{north east}{97}{3.2}\fi
    \end{tikzpicture}
  \end{frame}}
\newcommand\musectionframe{%
  \mu@sectionslide{seccion}{\insertsectionnumber}{\insertsection}{mudark}{white}{\mu@secsub}%
  \gdef\mu@secsub{}}
\newcommand\musubsectionframe{%
  \mu@sectionslide{subseccion}{\insertsectionnumber.\insertsubsectionnumber}{\insertsubsection}{mudark}{muaccent}{\mu@subsecsub}%
  \gdef\mu@subsecsub{}}
\AtBeginSection[]{\ifdefstring{\mu@sectionpages}{true}{\musectionframe}{}}
\AtBeginSubsection[]{\ifdefstring{\mu@subsectionpages}{true}{\musubsectionframe}{}}

%% ---------- Formas de la marca ----------
% \muforma[opciones]{forma}     dibuja la forma donde se llama (queda sobre lo anterior,
%                               así que llámala antes del texto para que quede detrás)
% \muformabg[opciones]{forma}   la dibuja en el fondo de la diapositiva actual,
%                               siempre detrás del contenido, se llame donde se llame
% forma:   circulo | arco | cuenco | barra | gancho | corte
% Opciones (posición y tamaño en % de la página, con el origen arriba a la izquierda):
%   x, y        posición del punto de anclaje              (def. 50, 50)
%   w           ancho                                      (def. 20)
%   anchor      ancla del dibujo: center, north west, ...  (def. center)
%   color       accent | dark | deep | tint | cta | white  (def. accent; sigue la paleta)
%   rot         giro en grados, sentido antihorario        (def. 0)
%   flip        true espeja horizontalmente                (def. false)
%   opacity     0..1                                       (def. 1)
\pgfkeys{/mu/forma/.cd,
  x/.store in=\muf@x, y/.store in=\muf@y, w/.store in=\muf@w,
  anchor/.store in=\muf@anchor, color/.store in=\muf@color,
  rot/.store in=\muf@rot, opacity/.store in=\muf@opacity,
  flip/.is choice, flip/true/.code={\def\muf@flip{1}}, flip/false/.code={\def\muf@flip{0}},
  flip/.default=true}
\def\mu@formdefaults{\def\muf@x{50}\def\muf@y{50}\def\muf@w{20}\def\muf@anchor{center}%
  \def\muf@color{accent}\def\muf@rot{0}\def\muf@opacity{1}\def\muf@flip{0}}
% Dibuja un nodo: x y ancho ancla giro opacidad espejo archivo
\def\mu@drawform#1#2#3#4#5#6#7#8{%
  \pgfmathsetlength\mu@fw{#3*\paperwidth/100}%
  \node[anchor=#4,inner sep=0,rotate=#5,opacity=#6] at (#1,#2)
    {\ifnum#7=1\reflectbox{\includegraphics[width=\mu@fw]{\muassets formas/#8}}%
     \else\includegraphics[width=\mu@fw]{\muassets formas/#8}\fi};}
\newdimen\mu@fw
\def\mu@parseform#1#2{\mu@formdefaults\pgfkeys{/mu/forma/.cd,#1}%
  \edef\muf@file{f-#2-\muf@color-\mu@palette.png}%
  \ifdefstring{\muf@color}{cta}{\edef\muf@file{f-#2-cta.png}}{}%
  \ifdefstring{\muf@color}{white}{\edef\muf@file{f-#2-white.png}}{}%
  \edef\mu@formcall{\noexpand\mu@drawform{\muf@x}{\muf@y}{\muf@w}{\muf@anchor}{\muf@rot}{\muf@opacity}{\muf@flip}%
    {\muf@file}}}
\newcommand\muforma[2][]{%
  \begingroup\mu@parseform{#1}{#2}%
  \ifvmode\nointerlineskip\fi
  \hbox to 0pt{\begin{tikzpicture}[mupage]\mu@formcall\end{tikzpicture}\hss}%
  \ifvmode\nointerlineskip\fi
  \endgroup}
\newcommand\muformabg[2][]{%
  \begingroup\mu@parseform{#1}{#2}%
  \expandafter\expandafter\expandafter\gdef\expandafter\expandafter\expandafter\mu@bgforms\expandafter\expandafter\expandafter{\expandafter\mu@bgforms\mu@formcall}%
  \endgroup}

%% ---------- Diapositiva destacada ----------
\def\mu@darkcolors{%
  \setbeamercolor{normal text}{fg=white,bg=mudark}%
  \setbeamercolor{frametitle}{fg=white}%
  \setbeamercolor{footline}{fg=white}%
  \setbeamercolor{structure}{fg=white}%
  \setbeamercolor{alerted text}{fg=mucta}%
  \usebeamercolor[fg]{normal text}}
\newcommand\mudestacado[3][]{%
  {\mu@darkcolors
  \begin{frame}{#1}
    \gdef\mu@style{dark}%
    \vspace{2mm}
    {\bfseries\fontsize{20}{26}\selectfont #2\par}
    \vspace{4mm}
    {\fontsize{12}{16}\selectfont #3\par}
  \end{frame}}}

%% ---------- Contraportada ----------
\def\mu@thanks{Eskerrik asko}
\ifdefstring{\mu@lang}{es}{\def\mu@thanks{Muchas gracias}}{}
\ifdefstring{\mu@lang}{en}{\def\mu@thanks{Thank you}}{}
\newcommand\muthankstext[1]{\def\mu@thanks{#1}}
\newcommand\muclosing[1]{%
  \begin{frame}[plain]
    \gdef\mu@style{closing}%
    \begin{tikzpicture}[mupage]
      \node[inner sep=0,text=white,align=center,font=\bfseries\fontsize{20}{27}\selectfont] at (49.75,47.5)
        {\mu@thanks};
      \node[anchor=north west,inner sep=0,text=white,align=left,text width=.27\paperwidth,font=\fontsize{7.5}{10}\selectfont] at (71.5,69.8)
        {#1};
    \end{tikzpicture}
  \end{frame}}

